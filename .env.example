# Bu dosyayı ".env" olarak kopyalayıp gerçek değerleri girin.
# .env dosyası .gitignore'da olduğu için asla git'e/repoya gitmez.

# JWT gizli anahtarı — şu komutla üretin:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=BURAYA_URETILEN_ANAHTARI_YAPISTIRIN

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

DEBUG=false
DOMAIN=emlakfethiye.com.tr
